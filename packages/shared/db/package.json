  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.1.0",
    "tsup": "catalog:",
    "tsx": "^4.23.12",
    "vitest": "catalog:testing"
  },
  "dependencies": {
    "@grocery-tracker/domain-model": "workspace:^",
