    "stop": "tsx --env-file=./.env scripts/stop.ts",
    "destroy": "tsx --env-file=./.env scripts/destroy.ts",
    "reset": "tsx --env-file=./.env scripts/reset.ts",
    "seed": "tsx --env-file=./.env scripts/seed.ts",
    "gen:seed": "tsx --env-file=./.env scripts/genSeed.ts"
